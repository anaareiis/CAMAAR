<div style="margin-bottom:24px; display:flex; align-items:center; justify-content:space-between;">
  <div>
    <h1 style="font-size:1.4rem; color:#333; margin-bottom:4px;">Gestão de Templates</h1>
    <p style="color:#888; font-size:0.85rem;">Todos os templates base criados para avaliações</p>
  </div>
  <%= link_to "Novo Template", new_template_path,
        style: "background:#6B2482; color:white; padding:8px 16px; border-radius:4px; text-decoration:none; font-size:0.88rem;" %>
</div>

<% if @templates.empty? %>
  <p style="color:#888; font-size:0.9rem;">Nenhum template cadastrado.</p>
<% else %>
  <table style="width:100%; border-collapse:collapse; background:#fff; border-radius:4px; overflow:hidden; box-shadow:0 1px 6px rgba(0,0,0,0.08);">
    <thead>
      <tr style="background:#6B2482; color:white; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.5px;">
        <th style="padding:12px 16px; text-align:left;">Título do Template</th>
        <th style="padding:12px 16px; text-align:left;">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @templates.each_with_index do |template, i| %>
        <tr style="border-bottom:1px solid #f0f0f0; font-size:0.88rem; background:<%= i.odd? ? '#fafafa' : '#fff' %>;">
          <td style="padding:12px 16px; color:#333;">
            <strong><%= template.titulo %></strong>
          </td>
          <td style="padding:12px 16px;">
            <div style="display: flex; gap: 10px; align-items: center;">
              <%= link_to "Editar", edit_template_path(template),
                    style: "color:#6B2482; font-size:0.85rem; text-decoration:none;" %>
              
              <%= button_to "Deletar", template_path(template), method: :delete, 
                    form: { data: { turbo_confirm: 'Tem a certeza que deseja remover este template?' }, style: "margin: 0; padding: 0;" }, 
                    style: "color:#d9534f; font-size:0.85rem; background:none; border:none; cursor:pointer; text-decoration:none; padding: 0;" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>